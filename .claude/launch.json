{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "backend\\scripts\\run-backend.cmd"
      ],
      "port": 7070
